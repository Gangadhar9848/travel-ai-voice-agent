# Copy this file to .env and fill in ONE provider block.
PORT=3002

# ---- Which provider: openai | azure ----
LLM_PROVIDER=openai

# ---- OpenAI (or any OpenAI-compatible API) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Azure OpenAI ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Response tuning ----
# Leave LLM_TEMPERATURE empty for models that only accept the default
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
# How many past messages to send to the LLM each turn
HISTORY_LIMIT=20

# Some models require "none" to use tools on /chat/completions (e.g. gpt-6-luna)
LLM_REASONING_EFFORT=none

# ---- GetYourGuide activities ----
GYG_API_KEY=
GYG_LANGUAGE=EN
GYG_CURRENCY=EUR
# GYG_API_BASE_URL=https://api.getyourguide.com/1
# GYG_IMAGE_FORMAT=75

# ---- GPT-Live-1 (voice) ----
LIVE_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
LIVE_API_KEY=
LIVE_MODEL=gpt-live-1
LIVE_VOICE=
